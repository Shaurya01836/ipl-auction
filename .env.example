VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_auth_domain_here
VITE_FIREBASE_DATABASE_URL=your_database_url_here
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id_here
# Optional second Realtime Database (overflow server).
# The app works without the VITE_FIREBASE_B_* values; they are only needed if
# the secondary project requires its own web-app metadata.
VITE_RTDB_B_URL=your_second_database_url_here
VITE_FIREBASE_B_API_KEY=your_second_api_key_here
VITE_FIREBASE_B_AUTH_DOMAIN=your_second_auth_domain_here
VITE_FIREBASE_B_PROJECT_ID=your_second_project_id_here
VITE_FIREBASE_B_STORAGE_BUCKET=your_second_storage_bucket_here
VITE_FIREBASE_B_MESSAGING_SENDER_ID=your_second_messaging_sender_id_here
VITE_FIREBASE_B_APP_ID=your_second_app_id_here
VITE_AGORA_APP_ID=your_agora_app_id_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here
CRICKET_API_KEY=your_cricketdata_api_key_here
VITE_ADSENSE_CLIENT_ID=ca-pub-your_publisher_id_here
VITE_ADSENSE_LANDING_FOOTER_SLOT=your_landing_footer_ad_slot_here
