# ─── Main Firebase Project (Auth, Firestore, Primary RTDB) ──────────────────
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ─── Multi-Server RTDB Cluster Configuration ────────────────────────────────
# Comma-separated list to enable/order servers. Remove any server to disable it.
VITE_ENABLED_SERVERS=server-1,server-2,server-3,server-4,server-5

# Server 1 (Main RTDB)
VITE_RTDB_1_URL=https://your_project_1-default-rtdb.asia-southeast1.firebasedatabase.app

# Server 2 (RTDB Node 2)
VITE_RTDB_2_URL=https://your_project_2-default-rtdb.asia-southeast1.firebasedatabase.app

# Server 3 (RTDB Node 3)
VITE_RTDB_3_URL=https://your_project_3-default-rtdb.asia-southeast1.firebasedatabase.app

# Server 4 (RTDB Node 4)
VITE_RTDB_4_URL=https://your_project_4-default-rtdb.asia-southeast1.firebasedatabase.app

# Server 5 (RTDB Node 5)
VITE_RTDB_5_URL=https://your_project_5-default-rtdb.asia-southeast1.firebasedatabase.app

# ─── Supabase Database & Auth ──────────────────────────────────────────────
VITE_SUPABASE_URL=https://your_supabase_project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key

# ─── Application & Integrations ────────────────────────────────────────────
VITE_ADMIN_EMAIL=your_admin_email@gmail.com
VITE_CRICKET_API_KEY=your_cricket_api_key
VITE_GIPHY_API_KEY=your_giphy_api_key

# ─── Google AdSense ────────────────────────────────────────────────────────
VITE_ADSENSE_CLIENT_ID=ca-pub-your_adsense_id
VITE_ADSENSE_LANDING_FOOTER_SLOT=your_ad_slot_1
VITE_ADSENSE_LANDING_SLOT_1=your_ad_slot_1
VITE_ADSENSE_LANDING_SLOT_2=your_ad_slot_2
VITE_ADSENSE_LANDING_SLOT_3=your_ad_slot_3
VITE_ADSENSE_AUCTION_ROOM_SLOT=your_ad_slot
