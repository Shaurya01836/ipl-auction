{
  "rewrites": [
    {
      "source": "/((?!assets|.*\\.(?:css|js|png|jpg|jpeg|gif|svg|ico|woff2?|ttf|mp3|mpeg)).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
