{
  "rules": {
    /* 
      IPL Auction - Realtime Database Security Rules
      
      These rules secure the Realtime Database against unauthorized public access,
      preventing the "insecure rules" warning from Firebase, while maintaining
      full real-time functionality for authenticated auction players and guests.
    */
    ".read": false,
    ".write": false,

    "auctions": {
      ".read": "auth != null",
      "$roomId": {
        // Any authenticated user (including anonymous guest sign-ins) can read and delete auction state
        ".read": "auth != null",
        ".write": "auth != null",

        "room": {
          // Any authenticated user can write/sync the room state
          ".write": "auth != null"
        },
        "playerOrder": {
          // Any authenticated user can write/sync player order
          ".write": "auth != null"
        },
        "live": {
          // Any authenticated user can write/sync the live bidding state with atomic validation
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['status']) && (newData.child('status').val() == 'bidding' || newData.child('status').val() == 'sold' || newData.child('status').val() == 'unsold' || newData.child('status').val() == 'paused' || newData.child('status').val() == 'waiting' || newData.child('status').val() == 'processing_sale')"
        },
        "messages": {
          // Any authenticated user can write to the messages sub-path for chat synchronization
          ".write": "auth != null"
        },
        "teams": {
          // Any authenticated user can write/sync team roster data
          ".write": "auth != null"
        },
        "userSquads": {
          // Any authenticated user can write/sync their fantasy squad
          ".write": "auth != null"
        },
        "presence": {
          "$userId": {
            // Ensure that presence writes are strictly authorized to the user themselves
            ".write": "auth != null && auth.uid == $userId"
          }
        }
      }
    }
  }
}
